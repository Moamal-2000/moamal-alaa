# Your site's canonical origin. Use http://localhost:3000 for local development
# and your own deployed site URL in production. Do not include a trailing slash.
BASE_URL=http://localhost:3000

# A GitHub Personal Access Token used for GitHub GraphQL API requests.
# Create your own token for the GitHub account whose public data you want to display.
# Keep the token private; never commit your real .env file or token.
GITHUB_TOKEN=replace_with_your_github_personal_access_token
